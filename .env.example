# PostgreSQL connection string. `npm run db:dev` starts an embedded local PostgreSQL on this port.
DATABASE_URL="postgresql://dokaan:dokaan@localhost:54329/dokaan?schema=public"
# Secret used to derive daily-challenge seeds and sign server values. Use a long random string in production.
GAME_SECRET="change-me-to-a-long-random-string"
# Public site URL (used for share links and campaign URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# HelloKhata link target (campaign parameters are appended automatically).
NEXT_PUBLIC_HELLOKHATA_URL="https://hellokhata.com"
