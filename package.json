{
  "name": "dokaan-shamlao",
  "version": "0.1.0",
  "private": true,
  "description": "দোকান সামলাও! — a Bangladeshi shopkeeping arcade game, presented by HelloKhata",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prisma-generate-safe.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:integration",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:export": "tsx scripts/export-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/baloo-da-2": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.29",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
